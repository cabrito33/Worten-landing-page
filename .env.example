# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The URL where this applet is hosted.
# Used for direct proposal links in emails and routing.
APP_URL="MY_APP_URL"
APP_BASE_URL="MY_APP_BASE_URL"

# RESEND_API_KEY: API Key for Resend email notifications.
RESEND_API_KEY="re_123456789"

# EMAIL_ALUNO: Destination email for internal proposal notifications (sent from onboarding@resend.dev).
EMAIL_ALUNO=""

# ADMIN_UID: Firebase Authentication UID authorized to access the /admin area.
ADMIN_UID="YOUR_FIREBASE_ADMIN_UID"

# CAL_API_KEY: API Key for Cal.com v2 integration.
CAL_API_KEY=""

