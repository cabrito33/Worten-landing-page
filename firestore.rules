rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "afonso06pedro@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Catálogo: Leitura pública para exibir serviços, escrita permitida
    match /catalogo/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Pedidos: Permite submissão e consulta de pedidos
    match /pedidos/{pedidoId} {
      allow read, write: if true;
    }

    // Propostas: Consulta e gravação pública por token de acesso
    match /propostas/{propostaId} {
      allow read, write: if true;
    }

    // Coleção de administradores
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }
  }
}
